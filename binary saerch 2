# Aim: Implement Binary search to find an element in a list (Simple & File-based).

import os

# --- Helper: Create a sample words.txt file for the file-based search ---
if not os.path.exists("words.txt"):
    with open("words.txt", "w") as f:
        f.write("apple banana cherry grape orange peach strawberry watermelon")


# 1. Simple Binary Search (Numbers)
def binary_search(arr, target):
    left = 0
    right = len(arr) - 1
    
    while left <= right:
        mid = (left + right) // 2
        
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
            
    return -1


# 2. Binary Search in a File (Words)
def binary_search_in_file(filename, target):
    with open(filename, 'r') as file:
        content = file.read()
        words = content.split()
        
    words.sort()
    print("Sorted words:", words)
    
    left = 0
    right = len(words) - 1
    steps = 0
    
    while left <= right:
        mid = (left + right) // 2
        steps += 1
        print(f"Step {steps}: searching in range words[{left}:{right+1}]")
        
        if words[mid] == target:
            print(f"Target '{target}' found at index {mid} in {steps} steps.")
            return mid
        elif words[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
            
    print(f"Target '{target}' not found after {steps} steps.")
    return -1


# --- Driver Code ---
if __name__ == "__main__":
    # Test Simple Binary Search
    numbers = [3, 5, 1, 3, 9]
    numbers.sort()
    print("Sorted list (Numbers):", numbers)
    
    key = 5
    result = binary_search(numbers, key)
    if result != -1:
        print(f"Element {key} found at index {result}\n")
    else:
        print(f"Element {key} not found\n")
        
    print("-" * 50)
    
    # Test File-based Binary Search
    target_word = "grape"
    print(f"Searching for word '{target_word}' in 'words.txt':")
    binary_search_in_file("words.txt", target_word)
