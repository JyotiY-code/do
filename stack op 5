# Aim: To implement Stack operations such as push, pop, and display using a python list.

stack = []

def push(item):
    stack.append(item)
    print("Pushed:", item)

def pop():
    if len(stack) == 0:
        print("Stack is empty.")
    else:
        item = stack.pop()
        print("Popped:", item)

def display():
    print("Current stack:", stack)

# --- Driver Code / Test Operations ---
if __name__ == "__main__":
    push(10)
    push(20)
    push(30)
    display()
    pop()
    pop()
    pop()
    pop()  # Trying to pop from an empty stack to test empty condition
